{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["./jest-setup.ts"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true,
          "esModuleInterop": true
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs/jwt|@nestjs/core|@nestjs/common|@nestjs/passport|@nestjs/config|@nestjs/mongoose|@nestjs/platform-express)/)"
  ]
}
